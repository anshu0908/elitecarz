// EliteCarz schema — follows BRIEF.md §15.3.
// SQLite locally; portable to PostgreSQL by switching the provider. Enum-like
// columns are plain strings validated in lib/validation.ts. Array/JSON columns
// are JSON-encoded strings (SQLite has no arrays) — see lib/json.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ───────────── USERS & ROLES ─────────────
model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String?
  role         String // owner | manager | sales | viewer
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  carsCreated   Car[]          @relation("CarCreatedBy")
  carsUpdated   Car[]          @relation("CarUpdatedBy")
  leadsAssigned Lead[]
  leadNotes     LeadNote[]
  priceChanges  PriceHistory[]
  auditEntries  AuditLog[]
}

// ───────────── MASTER DATA ─────────────
model Make {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  logoUrl String?
  models  Model[]
  cars    Car[]
}

model Model {
  id       Int       @id @default(autoincrement())
  makeId   Int
  make     Make      @relation(fields: [makeId], references: [id])
  name     String
  bodyType String?
  variants Variant[]
  cars     Car[]

  @@unique([makeId, name])
}

model Variant {
  id           Int     @id @default(autoincrement())
  modelId      Int
  model        Model   @relation(fields: [modelId], references: [id])
  name         String
  fuel         String?
  transmission String?
  engine       String?
  cars         Car[]

  @@unique([modelId, name])
}

// ───────────── CARS ─────────────
model Car {
  id        String  @id @default(uuid())
  slug      String  @unique
  stockNo   String? @unique
  status    String  @default("draft") // draft | published | reserved | sold | archived

  makeId    Int?
  make      Make?    @relation(fields: [makeId], references: [id])
  modelId   Int?
  model     Model?   @relation(fields: [modelId], references: [id])
  variantId Int?
  variant   Variant? @relation(fields: [variantId], references: [id])

  title            String
  year             Int
  registrationYear Int?
  fuel             String
  transmission     String
  bodyType         String?
  kmDriven         Int?
  owners           Int?
  color            String?
  seats            Int?
  rto              String?
  regNumber        String? // ADMIN ONLY — full number
  regNumberMasked  String? // public, e.g. "DL 3C ••12"
  insuranceType    String?
  insuranceValidTill DateTime?

  priceInr      Int
  tcsApplicable Boolean @default(true)
  mrpNote       String?
  negotiable    Boolean @default(false)

  warrantyIncluded Boolean @default(false)
  warrantyMonths   Int?
  warrantyKm       Int?
  warrantyNote     String?

  engineCc    Int?
  powerBhp    Float?
  mileageKmpl Float?

  description String?
  highlights  String  @default("[]") // JSON string[]
  features    String  @default("[]") // JSON string[]
  disclosures String  @default("[]") // JSON string[] — honest known issues
  videoUrl    String?
  view360Url  String?

  featured    Boolean @default(false)
  badge       String? // New arrival | Price drop | Certified
  heroImageId String?

  // ADMIN ONLY — never selected by public queries
  purchasePriceInr Int?
  refurbCostInr    Int?
  source           String?
  notesInternal    String?

  // Fields invented for the pitch demo (e.g. ["owners","inspection"]). JSON string[].
  demoFields String @default("[]")

  views        Int       @default(0)
  publishedAt  DateTime?
  soldAt       DateTime?
  soldPriceInr Int?

  createdById String?
  createdBy   User?    @relation("CarCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("CarUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // SOFT DELETE

  images       CarImage[]
  documents    CarDocument[]
  inspections  Inspection[]
  priceHistory PriceHistory[]
  leads        Lead[]
  bookings     Booking[]

  @@index([status, priceInr])
  @@index([makeId, modelId])
  @@index([deletedAt])
}

model CarImage {
  id        String  @id @default(uuid())
  carId     String
  car       Car     @relation(fields: [carId], references: [id], onDelete: Cascade)
  url       String
  thumbUrl  String?
  alt       String?
  category  String? // exterior | interior | engine | tyres | docs | defects
  sortOrder Int     @default(0)
  isHero    Boolean @default(false)

  @@index([carId, sortOrder])
}

model CarDocument {
  id       String  @id @default(uuid())
  carId    String
  car      Car     @relation(fields: [carId], references: [id], onDelete: Cascade)
  type     String // rc | insurance | service_history | pollution | challan_check | loan_noc | inspection_pdf | other
  fileUrl  String?
  verified Boolean @default(false)
  isPublic Boolean @default(false)
}

model Inspection {
  id           String           @id @default(uuid())
  carId        String
  car          Car              @relation(fields: [carId], references: [id], onDelete: Cascade)
  inspectedBy  String?
  inspectedOn  DateTime?
  overallScore Float?
  summary      String?
  reportPdfUrl String?
  isDemo       Boolean          @default(false)
  items        InspectionItem[]
}

model InspectionItem {
  id           String     @id @default(uuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  section      String
  item         String
  result       String // pass | minor | fail | na
  note         String?
  photoUrl     String?
}

model PriceHistory {
  id          Int      @id @default(autoincrement())
  carId       String
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  oldPrice    Int
  newPrice    Int
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())
}

// ───────────── LEADS / CRM ─────────────
model Lead {
  id             String    @id @default(uuid())
  type           String // enquiry | call_back | test_drive | reserve | finance | sell_car | contact | whatsapp_click | newsletter
  status         String    @default("new") // new | contacted | visit_scheduled | negotiating | won | lost | spam
  name           String?
  phone          String?
  whatsapp       String?
  email          String?
  city           String?
  carId          String?
  car            Car?      @relation(fields: [carId], references: [id])
  payload        String    @default("{}") // JSON, type-specific
  message        String?
  source         String?
  utm            String? // JSON
  pageUrl        String?
  assignedToId   String?
  assignedTo     User?     @relation(fields: [assignedToId], references: [id])
  nextFollowupAt DateTime?
  lostReason     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notes        LeadNote[]
  sellRequests SellRequest[]
  bookings     Booking[]

  @@index([status, createdAt])
  @@index([phone])
}

model LeadNote {
  id        Int      @id @default(autoincrement())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  note      String
  createdAt DateTime @default(now())
}

model SellRequest {
  id             String    @id @default(uuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  regNumber      String?
  make           String?
  model          String?
  variant        String?
  mfgYear        Int?
  regYear        Int?
  owners         Int?
  kmRange        String?
  fuel           String?
  transmission   String?
  state          String?
  expectedPrice  Int?
  photos         String    @default("[]") // JSON string[]
  offeredMin     Int?
  offeredMax     Int?
  inspectionSlot DateTime?
  outcome        String?
}

model Booking {
  id            String    @id @default(uuid())
  leadId        String?
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  carId         String?
  car           Car?      @relation(fields: [carId], references: [id])
  kind          String // test_drive | reservation
  slot          DateTime?
  tokenAmount   Int?
  paymentStatus String?
  paymentRef    String?
  refundStatus  String?
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
}

// ───────────── CONTENT ─────────────
model Review {
  id          String    @id @default(uuid())
  author      String
  rating      Int
  body        String
  source      String    @default("google")
  isParaphrase Boolean  @default(true)
  carLabel    String?
  photoUrl    String?
  isFeatured  Boolean   @default(false)
  isPublished Boolean   @default(true)
  reviewedOn  String? // as shown on Google, e.g. "5 months ago"
}

model Faq {
  id          Int     @id @default(autoincrement())
  question    String
  answer      String
  category    String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
}

model Post {
  id             String    @id @default(uuid())
  slug           String    @unique
  title          String
  excerpt        String?
  bodyMd         String?
  coverUrl       String?
  status         String    @default("draft")
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
}

model TeamMember {
  id        Int     @id @default(autoincrement())
  name      String
  role      String?
  photoUrl  String?
  bio       String?
  phone     String?
  sortOrder Int     @default(0)
}

model Banner {
  id        Int       @id @default(autoincrement())
  title     String
  subtitle  String?
  imageUrl  String?
  ctaLabel  String?
  ctaUrl    String?
  startsOn  DateTime?
  endsOn    DateTime?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
}

model Page {
  id             Int     @id @default(autoincrement())
  slug           String  @unique
  title          String
  bodyMd         String
  seoTitle       String?
  seoDescription String?
}

model Lender {
  id              Int     @id @default(autoincrement())
  name            String
  logoUrl         String?
  minRate         Float
  maxRate         Float
  maxTenureMonths Int
  isActive        Boolean @default(true)
}

model Redirect {
  id        Int      @id @default(autoincrement())
  fromPath  String   @unique
  toPath    String
  code      Int      @default(301)
  createdAt DateTime @default(now())
}

// ───────────── SETTINGS & AUDIT ─────────────
model Setting {
  key   String @id
  value String // JSON
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  diff      String? // JSON
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
