# Database — SQLite locally (file:./prisma/dev.db). Deployed: Turso libsql:// URL + DATABASE_AUTH_TOKEN.
# Database — SQLite locally. For Postgres: change provider in prisma/schema.prisma and use a postgres:// URL.
DATABASE_URL="file:./prisma/dev.db"
# 32+ random characters (e.g. `openssl rand -hex 32`). Required in production.
SESSION_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional — Cloudflare Turnstile. If unset, forms rely on rate limiting + honeypot only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Optional — lead notification emails via Resend. If unset, notifications are logged to the console.
RESEND_API_KEY=""
NOTIFY_FROM="EliteCarz Leads <leads@elitecarz.in>"
ALLOW_INDEXING="false"
DATABASE_AUTH_TOKEN=""
# Vercel Blob read/write token (added automatically when you connect a Blob store in Vercel). Unset = local ./uploads folder.
BLOB_READ_WRITE_TOKEN=""
# Login page demo-account box: set SHOW_DEMO_LOGINS="false" to hide it, or DEMO_LOGIN_HINT to show your own password.
SHOW_DEMO_LOGINS="true"
DEMO_LOGIN_HINT=""
# Only used by the seed script.
SEED_ADMIN_PASSWORD=""
